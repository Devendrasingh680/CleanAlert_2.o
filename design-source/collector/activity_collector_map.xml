<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9FB"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CleanAlert"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Collection Map"
                android:textColor="#888888"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_collector_avatar"
            android:gravity="center"
            android:text="RK"
            android:textColor="#20B968"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Map Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E7ECE9">

        <!-- Simple map background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_map"
            android:orientation="vertical">

            <!-- Map road representation -->
            <View
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="80dp"
                android:background="#FFFFFF"
                android:rotation="8" />

            <View
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="45dp"
                android:background="#FFFFFF"
                android:rotation="-12" />

            <View
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="55dp"
                android:background="#FFFFFF"
                android:rotation="5" />

        </LinearLayout>

        <!-- Current Location -->
        <TextView
            android:id="@+id/currentLocationMarker"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_map_marker"
            android:gravity="center"
            android:text="●"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Collection Marker 1 -->
        <TextView
            android:id="@+id/markerOne"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="85dp"
            android:layout_marginTop="130dp"
            android:background="@drawable/bg_collection_marker"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Collection Marker 2 -->
        <TextView
            android:id="@+id/markerTwo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="185dp"
            android:layout_marginEnd="80dp"
            android:background="@drawable/bg_collection_marker"
            android:gravity="center"
            android:text="2"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Collection Marker 3 -->
        <TextView
            android:id="@+id/markerThree"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="125dp"
            android:layout_marginBottom="125dp"
            android:background="@drawable/bg_collection_marker"
            android:gravity="center"
            android:text="3"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Map Controls -->
        <LinearLayout
            android:layout_width="50dp"
            android:layout_height="100dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnZoomIn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="+"
                android:textColor="#333333"
                android:textSize="24sp"
                android:textStyle="bold" />

            <View
                android:layout_width="30dp"
                android:layout_height="1dp"
                android:layout_gravity="center"
                android:background="#EEEEEE" />

            <TextView
                android:id="@+id/btnZoomOut"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:gravity="center"
                android:text="−"
                android:textColor="#333333"
                android:textSize="24sp" />

        </LinearLayout>

        <!-- Locate Me -->
        <TextView
            android:id="@+id/btnMyLocation"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_white_card"
            android:gravity="center"
            android:text="⌖"
            android:textColor="#20B968"
            android:textSize="25sp" />

    </FrameLayout>

    <!-- Selected Collection Card -->
    <LinearLayout
        android:id="@+id/collectionInfoCard"
        android:layout_width="match_parent"
        android:layout_height="125dp"
        android:background="#FFFFFF"
        android:elevation="5dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_profile_icon"
                android:gravity="center"
                android:text="W"
                android:textColor="#20B968"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSelectedResident"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rohan Kumar"
                    android:textColor="#222222"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="MG Road, Sector 4"
                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.8 km"
                android:textColor="#20B968"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnNavigate"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_redeem_button"
            android:gravity="center"
            android:text="Navigate to Collection"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Dashboard"
            android:textColor="#888888"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Map"
            android:textColor="#20B968"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="History"
            android:textColor="#888888"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profile"
            android:textColor="#888888"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>