<?xml version='1.0' encoding='UTF-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F9F9FB" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="30dp" android:paddingTop="20dp" android:paddingEnd="30dp" android:paddingBottom="24dp">

        <!-- Top Bar -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="45dp" android:gravity="center_vertical" android:orientation="horizontal">

            <LinearLayout android:id="@+id/btnBack" android:layout_width="70dp" android:layout_height="match_parent" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal">

                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Back" android:src="@drawable/ic_arrow_back" android:tint="#222222"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Back" android:textColor="#222222" android:textSize="14sp"/>

            </LinearLayout>

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="CleanAlert" android:textColor="#111111" android:textSize="18sp" android:textStyle="bold"/>

            <ImageView android:id="@+id/ivNotification" android:layout_width="25dp" android:layout_height="25dp" android:contentDescription="Notifications" android:src="@drawable/ic_notification" android:tint="#222222"/>

        </LinearLayout>

        <!-- Title -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:text="Leaderboard" android:textColor="#111111" android:textSize="29sp" android:textStyle="bold"/>

        <!-- Subtitle -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Top performers in waste segregation" android:textColor="#888888" android:textSize="15sp"/>

        <!-- Locality / City Toggle -->
        <LinearLayout android:id="@+id/leaderboardToggle" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="22dp" android:background="@drawable/bg_role_selector" android:orientation="horizontal" android:padding="3dp">

            <TextView android:id="@+id/btnLocality" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_toggle_selected" android:gravity="center" android:text="Locality" android:textColor="#222222" android:textSize="14sp" android:textStyle="bold"/>

            <TextView android:id="@+id/btnCity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="City" android:textColor="#777777" android:textSize="14sp" android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout android:id="@+id/liveLeaderboardList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical"/>

        <!-- Top 3 (design sample, hidden once real data loads) -->
        <LinearLayout android:id="@+id/staticLeaderboardSample" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        </LinearLayout>

    </LinearLayout>

</ScrollView>