<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9FB"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="30dp"
    android:paddingTop="28dp"
    android:paddingEnd="30dp"
    android:paddingBottom="30dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                android:tint="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Back"
                android:textColor="#222222"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="CleanAlert"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="70dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <!-- Success Icon -->
    <LinearLayout
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="75dp"
        android:background="@drawable/bg_success"
        android:gravity="center">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Success"
            android:src="@drawable/ic_check"
            android:tint="#FFFFFF" />

    </LinearLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Redeemed!"
        android:textColor="#111111"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Your points have been successfully exchanged."
        android:textColor="#777777"
        android:textSize="15sp" />

    <!-- Voucher Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_white_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amazon Voucher"
            android:textColor="#222222"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Ã¢â€šÂ¹100 Gift Card"
            android:textColor="#20B968"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Coupon Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Coupon Code"
            android:textColor="#888888"
            android:textSize="13sp" />

        <!-- Coupon Code -->
        <TextView
            android:id="@+id/tvCouponCode"
            android:layout_width="230dp"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_coupon_code"
            android:gravity="center"
            android:text="AMZ-CLEAN-882"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- View My Rewards -->
    <TextView
        android:id="@+id/btnViewMyRewards"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="25dp"
        android:background="@drawable/bg_redeem_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="View My Rewards"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Back to Rewards Hub -->
    <TextView
        android:id="@+id/btnBackToRewards"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_outline_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Back to Rewards Hub"
        android:textColor="#20B968"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>