<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F9F9FB" android:orientation="vertical" android:paddingStart="30dp" android:paddingTop="18dp" android:paddingEnd="30dp" android:paddingBottom="20dp">

    <!-- Top Bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="45dp" android:gravity="center_vertical" android:orientation="horizontal">

        <LinearLayout android:id="@+id/btnBack" android:layout_width="70dp" android:layout_height="match_parent" android:clickable="true" android:focusable="true" android:gravity="center_vertical">

            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Back" android:src="@drawable/ic_arrow_back" android:tint="#222222"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Back" android:textColor="#222222" android:textSize="14sp"/>

        </LinearLayout>

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="CleanAlert" android:textColor="#111111" android:textSize="18sp" android:textStyle="bold"/>

        <View android:layout_width="70dp" android:layout_height="1dp"/>

    </LinearLayout>

    <!-- Title -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="My Rewards" android:textColor="#111111" android:textSize="29sp" android:textStyle="bold"/>

    <!-- Subtitle -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Manage your claimed discount vouchers" android:textColor="#888888" android:textSize="14sp"/>

    <!-- Tabs -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="22dp" android:background="@drawable/bg_reward_tabs" android:orientation="horizontal" android:padding="4dp">

        <TextView android:id="@+id/tabActive" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_tab_selected" android:gravity="center" android:text="Active" android:textColor="#20B968" android:textSize="14sp" android:textStyle="bold"/>

        <TextView android:id="@+id/tabRedeemed" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Redeemed" android:textColor="#888888" android:textSize="14sp"/>

    </LinearLayout>

    <!-- Rewards List -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="18dp" android:layout_weight="1" android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><LinearLayout android:id="@+id/liveActiveRewardsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <!-- Amazon Reward (design sample, hidden once real rewards load) -->
            <!-- Cafe Coffee Day -->
            <LinearLayout android:id="@+id/liveRedeemedList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

            <!-- Redeemed Example (design sample, hidden once real redemptions exist) -->
            </LinearLayout>

    </LinearLayout></ScrollView>

</LinearLayout>