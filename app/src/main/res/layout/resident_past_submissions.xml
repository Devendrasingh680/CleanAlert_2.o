<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F9F9FB" android:orientation="vertical" android:paddingStart="30dp" android:paddingTop="18dp" android:paddingEnd="30dp" android:paddingBottom="20dp">

    <!-- Top Bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="45dp" android:gravity="center_vertical" android:orientation="horizontal">

        <LinearLayout android:id="@+id/btnBack" android:layout_width="70dp" android:layout_height="match_parent" android:clickable="true" android:focusable="true" android:gravity="center_vertical">

            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Back" android:src="@drawable/ic_arrow_back" android:tint="#222222"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Back" android:textColor="#222222" android:textSize="14sp"/>

        </LinearLayout>

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="CleanAlert" android:textColor="#111111" android:textSize="18sp" android:textStyle="bold"/>

        <View android:layout_width="70dp" android:layout_height="1dp"/>

    </LinearLayout>

    <!-- Title -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Past Submissions" android:textColor="#111111" android:textSize="28sp" android:textStyle="bold"/>

    <!-- Filter Tabs -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp" android:scrollbars="none">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">

            <TextView android:id="@+id/filterAll" android:layout_width="105dp" android:layout_height="38dp" android:background="@drawable/bg_filter_selected" android:gravity="center" android:text="All Waste" android:textColor="#20B968" android:textSize="13sp" android:textStyle="bold"/>

            <TextView android:id="@+id/filterOrganic" android:layout_width="125dp" android:layout_height="38dp" android:layout_marginStart="10dp" android:background="@drawable/bg_filter_unselected" android:gravity="center" android:text="Organic (Wet)" android:textColor="#777777" android:textSize="13sp"/>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Submission List -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <LinearLayout android:id="@+id/liveSubmissionList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

        <LinearLayout android:id="@+id/staticSubmissionList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- Bottom Navigation -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:background="#FFFFFF" android:gravity="center" android:orientation="horizontal">

        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Home" android:textColor="#888888" android:textSize="11sp"/>
        <TextView android:id="@+id/navResHistory" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="History" android:textColor="#20B968" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:id="@+id/navRewards" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Rewards" android:textColor="#888888" android:textSize="11sp"/>
        <TextView android:id="@+id/navResProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Profile" android:textColor="#888888" android:textSize="11sp"/>

    </LinearLayout>

</LinearLayout>