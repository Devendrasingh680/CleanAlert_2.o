<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9FB"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvHomeGreeting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hello, Resident" android:textColor="#111827" android:textSize="23sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Keep your neighbourhood clean" android:textColor="#6B7280" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_profile_avatar" android:gravity="center" android:text="RS" android:textColor="#22C55E" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="105dp" android:layout_marginTop="24dp" android:background="@drawable/bg_white_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
        <LinearLayout android:id="@+id/openPointsStreak" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your points" android:textColor="#6B7280" android:textSize="12sp" />
            <TextView android:id="@+id/tvHomePoints" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0" android:textColor="#111827" android:textSize="27sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/tvHomeStreak" android:layout_width="92dp" android:layout_height="42dp" android:background="@drawable/bg_points_pill" android:gravity="center" android:text="0 Day Streak" android:textColor="#22C55E" android:textSize="12sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Quick action" android:textColor="#111827" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/btnSubmitWaste" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="12dp" android:background="@drawable/bg_button_green" android:gravity="center" android:text="Submit Waste" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Recent activity" android:textColor="#111827" android:textSize="18sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/homeActivityList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:background="@drawable/bg_white_card" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No submissions yet" android:textColor="#111827" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Submit a photo to earn points" android:textColor="#6B7280" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Home"
            android:textColor="#20B968"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navResHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="History"
            android:textColor="#888888"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navRewards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Rewards"
            android:textColor="#888888"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navResProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profile"
            android:textColor="#888888"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
