<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F9F9FB">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <TextView android:id="@+id/btnHome" android:layout_width="wrap_content" android:layout_height="42dp" android:gravity="center_vertical" android:text="‹  Back" android:textColor="#111827" android:textSize="15sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Submit Waste" android:textColor="#111827" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Take a clear photo of the waste you reported." android:textColor="#6B7280" android:textSize="14sp" />
        <ImageView android:id="@+id/ivWastePhoto" android:layout_width="match_parent" android:layout_height="260dp" android:layout_marginTop="24dp" android:background="@drawable/bg_white_card" android:contentDescription="Selected waste photo" android:scaleType="centerCrop" />
        <TextView android:id="@+id/btnPickPhoto" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:background="@drawable/bg_button_outline" android:gravity="center" android:text="Choose Photo" android:textColor="#22C55E" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/btnTakePhoto" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/bg_button_outline" android:gravity="center" android:text="Take Photo" android:textColor="#22C55E" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/btnSubmitWasteFinal" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="14dp" android:background="@drawable/bg_button_green" android:gravity="center" android:text="Submit for Verification" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="Your photo is stored securely and reviewed by CleanAlert." android:textColor="#9CA3AF" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
